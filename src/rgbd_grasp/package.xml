<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rgbd_grasp</name>
  <version>0.0.0</version>
  <description>Guarded single-shot RGB-D blue-block grasping for MentorPi / LanderPi.</description>
  <maintainer email="189249227+Parco3037@users.noreply.github.com">ubuntu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>deptrum-ros-driver-aurora930</exec_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>kinematics</exec_depend>
  <exec_depend>kinematics_msgs</exec_depend>
  <exec_depend>raicom_control</exec_depend>
  <exec_depend>ros_robot_controller</exec_depend>
  <exec_depend>servo_controller</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_robot_controller_msgs</exec_depend>
  <exec_depend>servo_controller_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
